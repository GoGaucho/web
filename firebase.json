{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "dist",
    "headers": [{
      "source": "**",
      "headers": [{ "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }]
    }],
    "rewrites": [
      {
        "source": "/api/dining/week",
        "function": { "functionId": "weeklyDiningMenu", "region": "us-central1" }
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  }
}
